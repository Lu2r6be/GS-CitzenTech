# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* vão para dentro do app: NUNCA ponha segredo aqui.
# Endereço da API. No celular, "localhost" é o próprio celular: use o túnel do cloudflared ou o IP do PC.
EXPO_PUBLIC_API_URL=https://SEU-TUNEL.trycloudflare.com
# 1 = mostra os botões "Preencher como agente/familiar" na tela de login (só para demonstração).
EXPO_PUBLIC_MODO_DEMO=1
